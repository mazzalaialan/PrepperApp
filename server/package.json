{
  "name": "vikarg-server",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Servidor opcional y autoalojable de VikArg Prepping Tools: notificaciones push y transferencia de backups.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "maps:elevation": "node src/maps/buildElevation.ts",
    "maps:vector": "sh src/maps/build-vector.sh",
    "maps:update": "sh src/maps/update-maps.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "h5wasm": "^0.10.3",
    "pmtiles": "4.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
