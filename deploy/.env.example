# Dominio que apunta a este servidor (registro A/AAAA). Caddy obtiene el certificado HTTPS solo.
DOMAIN=vikarg.ejemplo.com

# Contacto que exige el protocolo Web Push. Opcional: si no se pone, se usa https://DOMAIN.
# VAPID_SUBJECT=mailto:vos@ejemplo.com

# Orígenes que pueden usar el servidor. '*' permite cualquier instalación de la app
# (la autenticación es por token por dispositivo). Para restringir:
# ALLOWED_ORIGINS=https://vikarg.ejemplo.com,https://mazzalaialan.github.io
ALLOWED_ORIGINS=*

# Tamaño máximo de un backup transferido, en MB.
TRANSFER_MAX_MB=50

# Biblioteca (opcional): carpeta de paquetes que arma tools/library-builder (run.sh package)
# y la clave con la que se cifraron los libros con derechos. Sin clave, solo se bajan los libres.
# LIBRARY_PATH=/home/usuario/vikarg-library/packages
# LIBRARY_KEY=
